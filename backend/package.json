{
    "name": "sia-mahasiswa-api",
    "version": "1.0.0",
    "private": "true",
    "types": "module",
    "description": "",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "migrate:up": "dotenv -e .env -- node-pg-migrate up -m migrations",
        "migrate:down": "dotenv -e .env -- node-pg-migrate down -m migrations",
        "migrate:create": "node-pg-migrate create",
        "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "jose": "^6.2.17",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "dotenv-cli": "^11.1.0",
        "node-pg-migrate": "^9.0.0",
        "nodemon": "^3.1.14",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}